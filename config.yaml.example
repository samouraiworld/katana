# katana configuration.
#
# katana is a permanent backend. Everything is configured here, including values
# usually passed as environment variables. A few secrets/per-deployment values
# can be overridden from the environment (annotated `env:` below).
#
# katana is BROADCAST-ONLY: every eligible validator results in a signed,
# broadcast GovDAO proposal — there is no dry-run mode. gnokey ships inside the
# container image (pinned by the GNO_REF build-arg); the signing key is
# provisioned from a mnemonic at startup, or from a pre-provisioned keybase.
#
# Copy this file to config.yaml and adjust it.

log_level: info                 # env: KATANA_LOG_LEVEL

# Daemon cadence: how often each chain worker re-evaluates its validators.
# This is the RUN cadence — NOT a condition window (see conditions.* below).
poll_interval: 5m

# ── gnomonitoring REST API ────────────────────────────────────────────────────
# Source of validator metrics (missed blocks + CRITICAL alerts).
# https://github.com/samouraiworld/gnomonitoring
gnomonitoring:
  base_url: "http://localhost:8989"   # env: KATANA_GNOMON_BASE_URL
  api_token: ""                       # env: KATANA_GNOMON_API_TOKEN (admin alerts endpoint)
  timeout_seconds: 10
  missed_blocks_path: "/missing_block"
  alerts_path: "/admin/alerts"
  info_path: "/info"                  # chain-discovery endpoint (validation)
  discover_chains: true               # validate config chains against /info at startup

# ── Proposing wallet (global default) ─────────────────────────────────────────
# A signing key is always required: katana always signs & broadcasts. Overridable per chain.
gnokey:
  bin: "gnokey"                       # env: KATANA_GNOKEY_BIN
  key_name: ""                        # keybase key name. env: KATANA_GNOKEY_KEY
  address: ""                         # proposing wallet g1... env: KATANA_GNOKEY_ADDRESS
  home: ""                            # keybase dir. env: KATANA_GNOKEY_HOME
  password: ""                        # SECRET. env: KATANA_GNOKEY_PASSWORD
  mnemonic: ""                        # SECRET. env: KATANA_GNOKEY_MNEMONIC
                                       # Set this (or KATANA_GNOKEY_MNEMONIC) to import a
                                       # signing key into the keybase at startup. Leave empty
                                       # to use a pre-provisioned keybase at `home` instead.
  gas_fee: "1000000ugnot"
  gas_wanted: 20000000

# ── Eligibility conditions ────────────────────────────────────────────────────
# require_all: true  -> every enabled condition must trigger (AND)
# require_all: false -> any single enabled condition is enough (OR)
conditions:
  require_all: false
  missed_blocks:
    enabled: true
    max: 100                          # eligible when missed blocks over `interval` > max
    interval: current_week            # CONDITION WINDOW: current_week|current_month|current_year|all_time
  critical_alerts:
    enabled: true
    max: 3                            # eligible when CRITICAL alerts over `interval` > max
    interval: 168h                    # CONDITION WINDOW: Go duration (168h = 7d)

# ── Exceptions ────────────────────────────────────────────────────────────────
# Validators never proposed for ejection. Matched by address (recommended) or
# moniker. Global list ∪ each chain's own list (a chain can only add).
exceptions:
  - "g1protectedvalidator..."

# ── Proposal creation + lifecycle ─────────────────────────────────────────────
proposal:
  # enabled: true broadcasts on-chain (default). Set false for observe-only:
  # katana still evaluates and NOTIFIES but does not sign/broadcast. The observe
  # notification attaches the ejection .gno script (Discord/Telegram) and gives
  # the ready-to-run gnokey command, so an operator can broadcast it by hand. Not
  # a dry-run/artifact mode. Overridable per chain via chains.<name>.proposal.enabled.
  enabled: true
  cooldown: 720h                      # min interval between two proposals for the same validator (30d)
  rejected_backoff: 720h              # wait after a GovDAO rejection before re-proposing (30d)
  max_rejections: 2                   # stop after N GovDAO rejections; 0 = unlimited

  # Submission method:
  #   run  -> broadcast a .gno script via `gnokey maketx run` (default; this is
  #           how gno.land valset ejection works — v3's builder can't be reached
  #           by a direct MsgCall). The default run_script_template ejects the
  #           validator (ValoperChange Power=0). Uses {operator_address}.
  #   call -> a single `gnokey maketx call` to realm_pkg_path.function with args.
  submit: run
  # run_script_template: (defaults to the built-in gno.land ejection script;
  #   override only for a different realm. Placeholders: {operator_address}
  #   {title} {description}.)

  # call-mode only (unused when submit: run):
  # realm_pkg_path: "gno.land/r/..."
  # function: "..."
  # args: ["{operator_address}"]

  title_template: "Eject validator {moniker} ({address}) from the valset"
  description_template: |
    Automated ejection proposal generated by katana.
    Validator: {moniker} ({address})
    Reason: {reason}

# ── Vote tracking ─────────────────────────────────────────────────────────────
# Follows the GovDAO outcome of broadcast proposals.
vote_tracking:
  vote_poll_interval: 5m
  govdao_realm: "gno.land/r/gov/dao"
  status_source: rpc                  # rpc (vm/qrender) | graphql

# ── Notifications ─────────────────────────────────────────────────────────────
# Sent only after a successful broadcast (and accepted/rejected outcomes).
# Nothing is sent on errors.
notifications:
  enabled: true
  discord:
    enabled: false
    webhook_url: ""                   # env: KATANA_DISCORD_WEBHOOK
  slack:
    enabled: false
    webhook_url: ""                   # env: KATANA_SLACK_WEBHOOK
  telegram:
    enabled: false
    bot_token: ""                     # env: KATANA_TELEGRAM_TOKEN
    chat_id: ""                       # env: KATANA_TELEGRAM_CHAT_ID

# ── Storage ───────────────────────────────────────────────────────────────────
storage:
  driver: sqlite                      # none | sqlite
  sqlite_path: "./data/katana.db"

# ── Health server ─────────────────────────────────────────────────────────────
# Enable to expose GET /health for external liveness monitoring (e.g. Grafana).
web:
  enabled: true
  listen: ":8990"

# ── Chains ────────────────────────────────────────────────────────────────────
# chain_id            = gno.land chain id used for signing (gnokey -chainid)
# gnomonitoring_chain = the chain key gnomonitoring exposes via ?chain=
# A chain may override: poll_interval, conditions, proposal, gnokey (field
# merge), and add exceptions.
chains:
  test6:
    rpc_endpoint: "https://rpc.test6.testnets.gno.land"
    gnoweb_url: "https://test6.testnets.gno.land"
    chain_id: "test6"
    gnomonitoring_chain: "test6"
    enabled: true

  betanet:
    rpc_endpoint: "https://rpc.betanet.testnets.gno.land"
    gnoweb_url: "https://betanet.testnets.gno.land"
    chain_id: "betanet"
    gnomonitoring_chain: "gnoland1"
    enabled: true
    poll_interval: 2m
    gnokey:                           # per-chain wallet; omitted fields inherit the global block
      key_name: "katana-betanet"
      address: "g1betanetproposer..."
      password: ""                    # env: KATANA_GNOKEY_PASSWORD

  mainnet:
    rpc_endpoint: "https://rpc.gno.land"
    gnoweb_url: "https://gno.land"
    chain_id: "gno.land"
    gnomonitoring_chain: "mainnet"
    enabled: false
    poll_interval: 10m
