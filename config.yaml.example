# katana configuration.
#
# katana is a permanent backend. Everything is configured here, including values
# usually passed as environment variables. A few secrets/per-deployment values
# can be overridden from the environment (annotated `env:` below).
#
# katana BROADCASTS BY DEFAULT: every eligible validator results in a signed,
# broadcast GovDAO proposal, unless the chain sets `dry_run: true` (rehearsal
# mode: log + notify the would-be proposal, never broadcast). gnokey ships
# inside the container image (pinned by the GNO_REF build-arg); the signing key
# is provisioned from a mnemonic at startup, or from a pre-provisioned keybase.
#
# Copy this file to config.yaml and adjust it.

log_level: info                 # env: KATANA_LOG_LEVEL

# Daemon cadence: how often each chain worker re-evaluates its validators.
# This is the RUN cadence — NOT an action window (see proposal.actions.*.window
# below).
poll_interval: 5m

# dry_run: true rehearses every chain (or one chain, if set under chains.<name>)
# without ever signing or broadcasting — see "Rehearsal / dry-run" in README.md.
# Overridable per chain via chains.<name>.dry_run. Defaults to false.
dry_run: false

# ── gnomonitoring REST API ────────────────────────────────────────────────────
# katana does not compute validator metrics itself; it reads a computed
# per-validator health score (0-100) from a running gnomonitoring instance.
# https://github.com/samouraiworld/gnomonitoring
gnomonitoring:
  base_url: "http://localhost:8989"   # env: KATANA_GNOMON_BASE_URL
  api_token: ""                       # env: KATANA_GNOMON_API_TOKEN — sent as a
                                       # Bearer token on every request (incl.
                                       # reports_path) when set; leave empty if
                                       # the reports endpoint is public
  timeout_seconds: 10
  reports_path: "/api/reports/validators"   # per-validator computed health score
  info_path: "/info"                  # chain-discovery endpoint (validation)
  discover_chains: true               # validate config chains against /info at startup

# ── Proposing wallet (global default) ─────────────────────────────────────────
# A signing key is always required: katana always signs & broadcasts. Overridable per chain.
gnokey:
  bin: "gnokey"                       # env: KATANA_GNOKEY_BIN
  key_name: ""                        # keybase key name. env: KATANA_GNOKEY_KEY
  address: ""                         # proposing wallet g1... env: KATANA_GNOKEY_ADDRESS
  home: ""                            # keybase dir. env: KATANA_GNOKEY_HOME
  password: ""                        # SECRET. env: KATANA_GNOKEY_PASSWORD
  mnemonic: ""                        # SECRET. env: KATANA_GNOKEY_MNEMONIC
                                       # Set this (or KATANA_GNOKEY_MNEMONIC) to import a
                                       # signing key into the keybase at startup. Leave empty
                                       # to use a pre-provisioned keybase at `home` instead.
  gas_fee: "1000000ugnot"
  gas_wanted: 20000000

# ── Exceptions ────────────────────────────────────────────────────────────────
# Validators never proposed against (eject/lower_vp/raise_vp). Matched by
# address (recommended) or moniker. Global list ∪ each chain's own list (a
# chain can only add).
exceptions:
  - "g1protectedvalidator..."

# ── Score-driven actions ────────────────────────────────────────────────────
# katana reads gnomonitoring's computed health score (0-100) instead of raw
# missed-blocks/alert counts. At most one action applies per validator per
# cycle: action_priority decides which, when more than one action's
# threshold matches (on its own configured window).
proposal:
  action_priority: [eject, lower_vp, raise_vp]

  min_voting_power: 100             # absolute floor; protects a small validator
                                     # from being driven to ~0 VP by repeated
                                     # lower_vp instead of a real eject
  max_voting_power_share: 15        # ceiling as % of the chain's total valset VP

  cooldown: 720h                      # min interval between two proposals for the same validator (30d)
  rejected_backoff: 720h              # wait after a GovDAO rejection before re-proposing (30d)
  max_rejections: 2                   # stop after N GovDAO rejections; 0 = unlimited
  submit: run                         # run (default; required for lower_vp/raise_vp) | call (eject only)

  actions:
    # Thresholds default to gnomonitoring's own tier boundaries (Excellent
    # >=85 / Good >=60 / Watch >=30 / Critical <30); 60-84 is an intentional
    # no-action "stability zone".
    eject:
      score_below: 30
      window: current_month           # ACTION WINDOW: last_24h|current_week|current_month|current_year
      title_template: "Eject validator {moniker} ({address}) from the valset"
      description_template: |
        Automated ejection proposal generated by katana.
        Validator: {moniker} ({address})
        Score: {score}/100 (tier {tier}) over {window}
        Reason: {reason}
    lower_vp:
      score_below: 60
      window: current_week
      # Step = whichever of vp_step_percent_of_self% of the validator's own
      # current VP or vp_step_percent_of_total% of the chain's total valset
      # VP has the smaller magnitude — the tighter cap wins for this
      # validator's size. Recomputed from live data every cycle, so repeated
      # triggers don't compound.
      vp_step_percent_of_self: -20
      vp_step_percent_of_total: -2
      title_template: "Lower voting power of validator {moniker} ({address})"
      description_template: |
        Automated voting-power reduction generated by katana.
        Validator: {moniker} ({address})
        Score: {score}/100 (tier {tier}) over {window}
        Voting power: {current_power} -> {target_power}
        Reason: {reason}
    raise_vp:
      score_at_or_above: 85
      window: current_year              # longest window: raise_vp is the most
                                         # governance-sensitive action, requires
                                         # a sustained track record
      vp_step_percent_of_self: 20
      vp_step_percent_of_total: 2
      title_template: "Raise voting power of validator {moniker} ({address})"
      description_template: |
        Automated voting-power increase generated by katana.
        Validator: {moniker} ({address})
        Score: {score}/100 (tier {tier}) over {window}
        Voting power: {current_power} -> {target_power}
        Reason: {reason}

# ── Vote tracking ─────────────────────────────────────────────────────────────
# Follows the GovDAO outcome of broadcast proposals. GovDAO v3 resolves a
# proposal only when someone calls ExecuteProposal once YES or NO reaches the
# 66.66% supermajority; proposals never expire on-chain.
vote_tracking:
  vote_poll_interval: 5m
  govdao_realm: "gno.land/r/gov/dao"
  status_source: rpc                  # rpc (vm/qrender) | graphql
  execute_proposals: true             # katana calls ExecuteOrRejectProposal on its own proposals
                                      # once a supermajority is reached. Overridable per chain.
  pending_timeout: 336h               # 14d. A proposal still open after this is marked
                                      # expired: notified once, gated like a rejection, and
                                      # still watched for a late outcome. Overridable per chain.

# ── Notifications ─────────────────────────────────────────────────────────────
# Sent only after a successful broadcast (and accepted/rejected outcomes).
# Nothing is sent on errors.
notifications:
  enabled: true
  discord:
    enabled: false
    webhook_url: ""                   # env: KATANA_DISCORD_WEBHOOK
  slack:
    enabled: false
    webhook_url: ""                   # env: KATANA_SLACK_WEBHOOK
  telegram:
    enabled: false
    bot_token: ""                     # env: KATANA_TELEGRAM_TOKEN
    chat_id: ""                       # env: KATANA_TELEGRAM_CHAT_ID

# ── Storage ───────────────────────────────────────────────────────────────────
# sqlite is REQUIRED whenever any enabled chain may broadcast (dry_run false):
# katana refuses to start otherwise, because driver "none" keeps no lifecycle
# history and would re-broadcast the same ejection every cycle. Dry-run-only
# setups may use "none" (rehearsal dedup degrades; a startup warning is logged).
storage:
  driver: sqlite                      # none | sqlite
  sqlite_path: "./data/katana.db"

# ── Health server ─────────────────────────────────────────────────────────────
# Enable to expose GET /health for external liveness monitoring (e.g. Grafana).
web:
  enabled: true
  listen: ":8990"

# ── Chains ────────────────────────────────────────────────────────────────────
# chain_id            = gno.land chain id used for signing (gnokey -chainid).
#                       Asserted against the node's /status network id at every
#                       cycle and immediately before any broadcast; a mismatch
#                       (genesis reset) skips the cycle cleanly.
# gnomonitoring_chain = the chain key gnomonitoring exposes via ?chain=
# dry_run             = per-chain override of the root dry_run default: run
#                       the full pipeline but log + notify the would-be
#                       proposal (script attached + gnokey command) instead of
#                       signing/broadcasting. Use it to onboard a new chain or
#                       as a standing manual-approval mode.
# A chain may override: poll_interval, proposal (incl. actions/action_priority/
# VP bounds — whole-block replace), gnokey (field merge), and add exceptions.
chains:
  test6:
    rpc_endpoint: "https://rpc.test6.testnets.gno.land"
    gnoweb_url: "https://test6.testnets.gno.land"
    chain_id: "test6"
    gnomonitoring_chain: "test6"
    enabled: true
    # dry_run: true                   # uncomment to rehearse without broadcasting

  betanet:
    rpc_endpoint: "https://rpc.betanet.testnets.gno.land"
    gnoweb_url: "https://betanet.testnets.gno.land"
    chain_id: "betanet"
    gnomonitoring_chain: "gnoland1"
    enabled: true
    poll_interval: 2m
    gnokey:                           # per-chain wallet; omitted fields inherit the global block
      key_name: "katana-betanet"
      address: "g1betanetproposer..."
      password: ""                    # env: KATANA_GNOKEY_PASSWORD

  mainnet:
    rpc_endpoint: "https://rpc.gno.land"
    gnoweb_url: "https://gno.land"
    chain_id: "gno.land"
    gnomonitoring_chain: "mainnet"
    enabled: false
    poll_interval: 10m
