# Claude Code local files — never commit
.claude/
CLAUDE.md

# Local configuration (may contain secrets)
config.yaml

# Live e2e/runtime configs (may contain secrets) — keep only the *.example
/deploy/**/*.config.yaml
/deploy/**/*.host.yaml

# Secrets / credentials / keys
.env
.env.*
!.env.example
*.pem
*.key
# gnokey keybases and generated devnet key material
**/.gnokey*/
**/secrets/
**/.devaddrs.mk

# Runtime data (SQLite DB + proposal artifacts)
/data/
/proposals/
# Orphaned e2e bind-mount dir (compose uses a named volume; ignore if present)
/e2e-katana-data/

# Local devnet runtime state (regenerated by gnoland-test/bootstrap.sh) — heavy
# per-validator databases, WAL, and generated genesis; keep only source scripts.
/gnoland-test/validator*/
/gnoland-test/genesis.json
/gnoland-test/genesis_balances.txt

# SQLite history database
*.db

# Build output
/katana
/bin/

# Go
*.test
*.out
