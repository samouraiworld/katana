# katana config for the e2e stack (docker-compose.e2e.yml) — DRY-RUN variant.
#
# First e2e iteration: katana runs in-container, reads gnomonitoring by service
# name, and only produces dry-run proposal artifacts (no gnokey, no Clerk token).
# Only the `missed_blocks` condition is enabled → it uses gnomonitoring's PUBLIC
# /missing_block endpoint, so no admin token is required.
#
# To exercise a real broadcast + GovDAO vote, run katana on the HOST instead
# (gnokey + the devnet keybase) with gnoland-test/config.katana.local.yaml.example.

log_level: info
poll_interval: 15s

gnomonitoring:
  base_url: "http://gnomonitoring:8989"   # compose service name
  timeout_seconds: 10

conditions:
  require_all: false
  missed_blocks:
    enabled: true
    max: 5                                # low so a downed validator qualifies fast
    interval: current_week
  critical_alerts:
    enabled: false                        # needs the admin token; off for first e2e

proposal:
  mode: dry-run                           # no gnokey needed in-container
  submit: run                             # the artifact still shows the real maketx run script
  cooldown: 1h
  rejected_backoff: 1h
  title_template: "Eject validator {moniker} ({operator_address}) from the valset"
  description_template: |
    Automated ejection proposal generated by katana (e2e dry-run).
    Validator: {moniker} ({operator_address})
    Reason: {reason}
  output_dir: "/app/data/proposals"

storage:
  driver: sqlite
  sqlite_path: "/app/data/katana.db"

web:
  enabled: true
  listen: ":8990"

chains:
  local:
    rpc_endpoint: "http://validator:26657" # devnet service (valset safety check)
    gnoweb_url: "http://localhost:8890"     # host gnoweb for clickable links
    chain_id: "dev"
    gnomonitoring_chain: "local"
    enabled: true
