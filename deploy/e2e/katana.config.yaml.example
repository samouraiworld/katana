# katana e2e config TEMPLATE — BROADCAST against the local devnet, in-container.
#
# Copy this to `katana.config.yaml` (git-ignored) and set gnokey.mnemonic/password
# to your throwaway devnet test key below (config-first — this file is
# git-ignored and the devnet has no real funds, so a plaintext password here is
# fine). Alternatively leave mnemonic/password empty and uncomment the
# 'environment:' block in ../../docker-compose.e2e.yml to pass
# KATANA_GNOKEY_MNEMONIC/KATANA_GNOKEY_PASSWORD from the shell instead.
#
# gnokey is shipped inside the katana image (Dockerfile GNO_REF). katana imports
# the signing key into /app/data/keybase at startup.
#
# The signing key's address MUST be funded in the devnet genesis AND be a GovDAO
# member, otherwise the broadcast succeeds but no proposal is created — see
# 'make add-key' in gnoland-test/Makefile.

log_level: info
poll_interval: 15s
dry_run: false          # true = observe-only: evaluate + notify (attach .gno script + gnokey command), no broadcast

gnomonitoring:
  base_url: "http://gnomonitoring:8989"
  timeout_seconds: 10
  reports_path: "/api/reports/validators"   # per-validator computed health score

valopers_realm: "gno.land/r/gnops/valopers"

gnokey:
  bin: "gnokey"
  key_name: "katana-e2e"
  home: "/app/data/keybase"
  password: "devpassword123"                   # devnet-only throwaway keybase passphrase
  mnemonic: "<24-word devnet test mnemonic>"   # throwaway; devnet only
  gas_fee: "1000000ugnot"
  gas_wanted: 100000000   # headroom for maketx run script creation (eject alone fits in less, but this covers it)

proposal:
  action_priority: [eject]
  min_voting_power: 100
  max_voting_power_share: 15
  cooldown: 1h
  rejected_backoff: 1h
  max_rejections: 2
  submit: run
  actions:
    eject:
      score_below: 30                 # low, so a downed validator qualifies fast
      window: current_week
      title_template: "Eject validator {moniker} ({address}) from the valset"
      description_template: |
        Automated ejection proposal generated by katana (e2e broadcast).
        Validator: {moniker} ({address})
        Score: {score}/100 (tier {tier}) over {window}
        Reason: {reason}

vote_tracking:
  vote_poll_interval: 15s
  govdao_realm: "gno.land/r/gov/dao"
  status_source: rpc

notifications:
  enabled: true
  discord:
    enabled: true
    webhook_url: ""            # via env KATANA_DISCORD_WEBHOOK

storage:
  driver: sqlite
  sqlite_path: "/app/data/katana.db"

web:
  enabled: true
  listen: ":8990"

chains:
  local:
    rpc_endpoint: "http://validator:26657"
    gnoweb_url: "http://localhost:8890"
    chain_id: "dev"
    gnomonitoring_chain: "local"
    enabled: true
