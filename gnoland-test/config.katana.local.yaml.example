# katana config for the local gno.land devnet (this directory).
#
# Preprod / end-to-end: run katana against the devnet after gnomonitoring has
# recorded missed blocks / CRITICAL alerts for a validator (see the e2e flow in
# KATANA-E2E.md). Copy to ../config.yaml (repo root) and adjust the wallet.
#
# Addresses/keys are regenerated on every `bootstrap.sh` — see .devaddrs.mk and
# the `dev` account (passphrase devpassword123) documented in README.md.

log_level: info
poll_interval: 15s          # fast cadence for testing

gnomonitoring:
  base_url: "http://localhost:8989"   # gnomonitoring pointed at chain=local
  api_token: ""                       # set if /admin/alerts requires it

# The devnet `dev` account: sole GovDAO T1 member, funded, unrestricted.
gnokey:
  bin: "gnokey"
  key_name: "dev"
  home: "./gnoland-test/.gnokey-dev"  # relative to repo root; adjust as needed
  password: "devpassword123"          # devnet-only throwaway key
  gas_fee: "1000000ugnot"
  gas_wanted: 100000000

conditions:
  require_all: false
  missed_blocks:
    enabled: true
    max: 5                            # low, so a downed validator qualifies fast
    interval: current_week
  critical_alerts:
    enabled: true
    max: 0
    interval: 24h

proposal:
  mode: broadcast                     # exercise the real on-chain path
  cooldown: 1h
  rejected_backoff: 1h
  max_rejections: 2
  submit: run                         # gno.land valset ejection needs maketx run
  # Uses the built-in DefaultEjectScript (ValoperChange Power=0 via v3).
  title_template: "Eject validator {moniker} ({operator_address}) from the valset"
  description_template: |
    Automated ejection proposal generated by katana (e2e devnet).
    Validator: {moniker} ({operator_address})
    Reason: {reason}
  output_dir: "./data/proposals"

vote_tracking:
  vote_poll_interval: 15s
  govdao_realm: "gno.land/r/gov/dao"
  status_source: rpc

notifications:
  enabled: false                      # enable + set a webhook to test notifs

storage:
  driver: sqlite
  sqlite_path: "./data/katana.db"

web:
  enabled: true
  listen: ":8990"

chains:
  local:
    rpc_endpoint: "http://localhost:26658"
    gnoweb_url: "http://localhost:8890"
    chain_id: "dev"                   # devnet genesis chain_id
    gnomonitoring_chain: "local"
    enabled: true
